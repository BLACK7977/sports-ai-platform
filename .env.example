# ============================================================
# Sports AI Platform - Environment Variables Template
# Copy this file to .env.local and fill in the values.
# ============================================================

# Node environment: development | production | test
NODE_ENV=development

# ============================================================
# Supabase (Production Database)
# Obtener de: https://supabase.com/dashboard/project/_/settings/api
# ============================================================

# URL pública del proyecto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://vwyzdtlgbizrxqqpszki.supabase.co/rest/v1/

# Clave anon (segura para exponer en cliente) - usada solo para lectura pública si aplica
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave service_role (SOLO server-side, NUNCA exponer al cliente) - requerida para writes
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# OpenAI (LLM Provider)
# Obtener de: https://platform.openai.com/api-keys
# ============================================================

# API key de OpenAI para features de IA (análisis, predicciones, insights)
# Si no se provee, la app usa automáticamente MockProvider con respuestas demo
OPENAI_API_KEY=

# Modelo por defecto para análisis deportivos
OPENAI_MODEL=gpt-4o-mini

# ============================================================
# Gemini (Explanation Provider - server-only, NUNCA NEXT_PUBLIC_)
# ============================================================

# API key de Google Generative AI para explicaciones de predicciones.
# SOLO server-side. Sin esta key, la feature devuelve estado UNAVAILABLE.
GEMINI_API_KEY=

# Modelo por defecto para explicaciones (ajustable por configuración segura).
GEMINI_MODEL=gemini-3.1-flash-lite

# Usar datos demo en memoria aunque Supabase esté configurado
ENABLE_OFFLINE_MODE=false

# Usar Mock LLM aunque OPENAI_API_KEY exista
USE_LLM_MOCK=false

# ============================================================
# Vercel Cron (sync automático de Sportmonks — server-only)
# Authorization: Bearer <CRON_SECRET>. La ruta 401 si falta.
# ============================================================
CRON_SECRET=
